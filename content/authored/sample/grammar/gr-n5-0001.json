      "posKo": "동사",
      "form": "て形",
      "example": "{食|た}べてください"
    }
  ],
  "examples": [
    {
      "ja": "ここに[[{名前|なまえ}を{書|か}いてください]]。",
      "ko": "여기에 이름을 써 주세요."
