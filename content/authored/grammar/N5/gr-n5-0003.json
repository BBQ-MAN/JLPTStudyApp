  "id": "gr-n5-0003",
  "title": "〜ます・〜ません",
  "meaningKo": "~합니다 / ~하지 않습니다 (동사 정중체 현재)",
  "explanationKo": "동사의 ます형은 정중한 말투입니다. 부정은 ます를 ません으로 바꿉니다.\n\n일본어 동사의 현재형은 '늘 그렇게 한다'(습관)나 '앞으로 한다'(예정)를 나타냅니다. '지금 먹고 있다'처럼 지금 하는 중인 일은 〜ています로 말합니다.\n\n만드는 법: 1그룹 동사는 끝소리를 い단으로 바꾸고(のむ → のみます), 2그룹 동사는 る를 떼고(たべる → たべます), する는 します, くる는 きます입니다.",
  "connections": [
    {
      "posKo": "1그룹 동사",
      "form": "ます形",
      "example": "{書|か}きます"
    },
    {
      "posKo": "2그룹 동사",
      "form": "ます形",
      "example": "{見|み}ます"
    },
    {
      "posKo": "불규칙 동사",
      "form": "ます形",
      "example": "します・{来|き}ます"
    },
    {
      "posKo": "동사(부정)",
      "form": "ます形の語幹＋ません",
      "example": "{書|か}きません"
    }
  ],
  "examples": [
    {
      "ja": "{毎朝|まいあさ}コーヒーを[[{飲|の}みます]]。",
      "ko": "매일 아침 커피를 마십니다."
    },
    {
      "ja": "わたしは{肉|にく}を[[{食|た}べません]]。",
      "ko": "저는 고기를 먹지 않습니다."
    },
    {
      "ja": "{来週|らいしゅう}、{友|とも}だちが{日本|にほん}へ[[{来|き}ます]]。",
      "ko": "다음 주에 친구가 일본에 옵니다."
    },
    {
      "ja": "{日曜日|にちようび}は{何|なに}も[[しません]]。",
      "ko": "일요일에는 아무것도 하지 않습니다."
    }
  ]
}
